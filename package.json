{
  "name": "dcli",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Delegate bounded work from Claude Code to a different coding-agent CLI",
  "bin": {
    "dcli": "cli/dcli.js",
    "dcli-codex": "cli/dcli-codex.js",
    "dcli-opencode": "cli/dcli-opencode.js",
    "dcli-claude": "cli/dcli-claude.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node tests/run-tests.js",
    "test:full": "node tests/run-tests.js --suite full",
    "check": "npm run lint && npm run test:full"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "globals": "^17.8.0"
  }
}
